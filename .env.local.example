# Database Configuration
# PostgreSQL database URL for authentication
# Example: postgresql://user:password@localhost:5432/dashboard_auth
# For Render: postgresql://user:password@dpg-xxxxx.render.internal:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/sanfer_auth
AUTH_DATABASE_URL=postgresql://user:password@localhost:5432/sanfer_auth

# JWT Secret
# Use a strong random string in production
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Environment
NODE_ENV=development

# Server port (optional, defaults to 4174)
PORT=4174
